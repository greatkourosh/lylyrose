u0646\u200c\u0631\u06cc\u0632\u06cc \u0645\u0634\u06a9\u0644\u06cc \u067e\u06cc\u0634 \u0622\u0645\u062f."],"Unregistered Statuses":["\u0648\u0636\u0639\u06cc\u062a\u200c\u0647\u0627\u06cc \u062b\u0628\u062a \u0646\u0634\u062f\u0647"],"Are you sure?":["\u0622\u06cc\u0627 \u0645\u0637\u0645\u0626\u0646\u06cc\u062f\u061f"],"Your settings have been successfully saved.":["\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0634\u0645\u0627 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u0630\u062e\u06cc\u0631\u0647 \u0634\u062f."],"You have unsaved changes. If you proceed, they will be lost.":["\u0634\u0645\u0627 \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u0630\u062e\u06cc\u0631\u0647 \u0646\u0634\u062f\u0647 \u062f\u0627\u0631\u06cc\u062f. \u0627\u06af\u0631 \u0627\u062f\u0627\u0645\u0647 \u062f\u0647\u06cc\u062f\u060c \u0622\u0646\u0647\u0627 \u0627\u0632 \u062f\u0633\u062a \u062e\u0648\u0627\u0647\u0646\u062f \u0631\u0641\u062a."],"There was an error saving your settings. Please try again.":["\u062e\u0637\u0627\u06cc\u06cc \u062f\u0631 \u0647\u0646\u06af\u0627\u0645 \u0630\u062e\u06cc\u0631\u0647 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0634\u0645\u0627 \u0648\u062c\u0648\u062f \u062f\u0627\u0631\u062f\u060c \u0644\u0637\u0641\u0627 \u0645\u062c\u062f\u062f\u0627 \u062a\u0644\u0627\u0634 \u06a9\u0646\u06cc\u062f."],"Save settings":["\u0630\u062e\u06cc\u0631\u06c0 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a"],"Analytics settings":["\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u062a\u062c\u0632\u06cc\u0647 \u0648 \u062a\u062d\u0644\u06cc\u0644"],"Are you sure you want to reset all settings to default values?":["\u0622\u06cc\u0627 \u0627\u0637\u0645\u06cc\u0646\u0627\u0646 \u062f\u0627\u0631\u06cc\u062f \u06a9\u0647 \u0645\u06cc\u200c\u062e\u0648\u0627\u0647\u06cc\u062f \u062a\u0646\u0638\u06cc\u0645\u0627\u062a\u062a\u0627\u0646 \u0631\u0627 \u0628\u0647 \u0645\u0642\u0627\u062f\u06cc\u0631 \u067e\u06cc\u0634\u0641\u0631\u0636 \u0628\u0627\u0632\u06af\u0631\u062f\u0627