# --- LYLY ROSE local development environment ---
# Copy this file to .env and fill in the values below.
# Never commit .env. See .gitignore.

# --- WordPress ---
# Port the WordPress container publishes on the host.
WORDPRESS_PORT=8030
# Canonical site URL WordPress uses for every generated link and asset.
# Must match the host you browse from: the local HTTPS proxy
# (https://lylyrose.local -> 127.0.0.1:${WORDPRESS_PORT}) is the way in,
# because the published port itself is plain HTTP. Setting this to
# http://localhost:${WORDPRESS_PORT} makes assets fail under the HTTPS proxy.
WORDPRESS_SITE_URL=https://lylyrose.local
# Toggle WP_DEBUG (1 = on, 0 = off).
WORDPRESS_DEBUG=0

# --- MySQL / MariaDB ---
MYSQL_DATABASE=lylyrose
MYSQL_USER=lylyrose
MYSQL_PASSWORD=lylyrose_dev
MYSQL_ROOT_PASSWORD=lylyrose_root_dev

# --- phpMyAdmin (optional) ---
PMA_PORT=8031

# --- GitHub Configuration ---
GITHUB_USERNAME=your_github_username
GITHUB_URL=https://github.com/your_username/lylyrose
# GITHUB_PAT should be set in .env but never committed
# Example: GITHUB_PAT=github_pat_11AB...
