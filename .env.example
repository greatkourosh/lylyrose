# --- LYLY ROSE local development environment ---
# Copy this file to .env and fill in the values below.
# Never commit .env. See .gitignore.

# --- WordPress ---
# Port the WordPress container publishes on the host. Bound to 0.0.0.0, so the
# site is reachable from other devices on the LAN at
# http://<this-machine-ip>:${WORDPRESS_PORT} as well as from this machine via
# the Caddy proxy at https://lylyrose.local.
WORDPRESS_PORT=8030
# There is deliberately no site-URL setting: WordPress derives WP_HOME/WP_SITEURL
# from the incoming request host, so one database serves every hostname. Pinning
# a host here instead made every CSS/JS/image request resolve to that host, which
# rendered the site unstyled anywhere it did not resolve (other LAN devices).
# Toggle WP_DEBUG (1 = on, 0 = off).
WORDPRESS_DEBUG=0

# --- MySQL / MariaDB ---
MYSQL_DATABASE=lylyrose
MYSQL_USER=lylyrose
MYSQL_PASSWORD=lylyrose_dev
MYSQL_ROOT_PASSWORD=lylyrose_root_dev

# --- phpMyAdmin (optional) ---
PMA_PORT=8031

# --- GitHub Configuration ---
GITHUB_USERNAME=your_github_username
GITHUB_URL=https://github.com/your_username/lylyrose
# GITHUB_PAT should be set in .env but never committed
# Example: GITHUB_PAT=github_pat_11AB...

# --- Deploy target (host) ---
# Document root for this site relative to the FTP login root (/home3/bqwyvowk).
# The account's public_html is the Vega Codex marketing site — not this one.
# docker/deploy-targeted.py exits if this is unset, rather than guessing.
LYLYROSE_FOLDER=lylyroseir
